{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kat",
  "scopeName": "source.kat",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#function-declaration" },
    { "include": "#function-call" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kat",
          "match": "\\b(if|while|break|return)\\b"
        },
        {
          "name": "storage.type.kat",
          "match": "\\b(var|const|fn)\\b"
        },
        {
          "name": "support.function.builtin.kat",
          "match": "\\bprint\\b"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.type.kat" },
        "2": { "name": "entity.name.function.kat" }
      }
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.kat" }
      }
    },
    "strings": {
      "name": "string.quoted.double.kat",
      "begin": "\"",
      "end": "\""
    },
    "numbers": {
      "name": "constant.numeric.kat",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.kat",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.kat",
          "match": "==|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.arithmetic.kat",
          "match": "\\+|-|\\*|%|<>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.kat",
          "match": "[(),]"
        },
        {
          "name": "punctuation.definition.block.kat",
          "match": "[{}]"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.kat",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
